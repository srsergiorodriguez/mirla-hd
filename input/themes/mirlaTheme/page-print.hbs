<!DOCTYPE html>
<html lang="{{@website.language}}">

<head>
  <meta charset="utf-8">
  <title>{{title}} - {{@website.name}}</title>

  {{!-- Load google fonts --}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&family=Syne:wght@400..800&display=swap" rel="stylesheet">

  <style>
    :root {
      --page-width: 5.5in;
      --page-height: 8.1in;

      /* Typography Variables */
      --font-body: "IBM Plex Sans", sans-serif;
      --font-heading: "Syne", sans-serif;
      --font-code: 'Source Code Pro', monospace;
      --size-code: 8pt;
    }

    img, canvas {
      filter: grayscale(100%) brightness(120%) contrast(120%); /* For improving B&W, laser printed publications */
    }

    body {
      background-color: gray;
    }

    .footnote {
      font-family: var(--font-body);
      float: footnote; /* superscript */
      font-size: 8pt;
      line-height: 1.2;
      text-align: left;
      text-justify: none;
    }

    /* Number in text */
    ::footnote-call {
      font-size: 0.8em;
      vertical-align: super;
      line-height: none;
    }

    /* Number at the bottom */
    ::footnote-marker {
      font-size: 8pt;
      margin-right: 0.5em;
    }

    /* Page config */
    @page {
      /* top, right, bottom, left */ 
      margin: 20mm 13mm 20mm 13mm;

      @top-center {
        /* Page name name */
        content: "{{title}}";
        font-family: var(--font-heading);
        font-size: 8pt;
        color: #494949;
      }

      @footnote {
        float: bottom;
        border-top: 0.5pt solid black;
        padding-top: 8pt;
        margin-top: 5mm;
      }
    }

    /* Even pages, left */
    @page :left {
      margin-right: 16mm;
      /* Uncomment this when using sidenotes: */
      /* margin-left: 40mm;  */

      @top-left-corner {
        content: counter(page);
        font-family: var(--font-heading);
        font-size: 8pt;
        /* This can be used to adjust the page number when using sidenotes: */
        /* text-align: center; */
      }
    }

    /* Odd pages, right */
    @page :right {
      margin-left: 16mm;
      /* Uncomment this when using sidenotes: */
      /* margin-right: 40mm;  */
      
      @top-right-corner {
        content: counter(page);
        font-family: var(--font-heading);
        font-size: 8pt;
        /* This can be used to adjust the page number when using sidenotes: */
        /* text-align: center; *//
      }
    }

    #page-entry {
      font-family: var(--font-body);
      font-size: 11pt;
      line-height: 1.3;
      color: #000;
      text-align: justify;
      text-align-last: left;
    }

    pre {
      white-space: pre-wrap;       /* CSS3 */
      white-space: -moz-pre-wrap;  /* Mozilla */
      white-space: -pre-wrap;      /* Opera 4-6 */
      white-space: -o-pre-wrap;    /* Opera 7 */
      word-wrap: break-word;       /* IE 5.5+ / Modern browsers */
      overflow-wrap: break-word;
      
      background-color: #d3d3d3;
      padding: 3mm;
      
      font-family: var(--font-code);
      font-size: var(--size-code);
      line-height: 1.4;
      break-inside: avoid; /* Tries to prevent the code block from splitting across two pages */
    }

    code {
      font-family: var(--font-code);
      font-size: var(--size-code);
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    #page-entry p {
      orphans: 2;
      /* Minimum lines at the bottom of a page */
      widows: 2;
      /* Minimum lines at the top of a page */
    }

    @media print {
      .pagedjs_pages {
        display: block !important;
        padding: 0 !important;
      }

      .pagedjs_page {
        background-color: white;
        margin: 0 !important;
        border: none !important;
        margin-bottom: 10px !important;
      }
    }

    /* Use this classes for creating chapters and other page breaks */

    .right-page-break {
      break-before: right;
    }

    .left-page-break {
      break-before: left;
    }
    
    .page-break {
      break-before: page;
    }

    .no-page-number {
      @top-left-corner {
        content: none;
      }

      @top-right-corner {
        content: none;
      }
    }

    /* Text */

    h1,h2,h3,h4,h5,h6 {
      font-family: var(--font-heading);
      text-align: left;
      text-align-last: left;
      break-after: avoid;
    }

    h1 {
      text-align: center;
      text-align-last: center;
      margin-bottom: 2rem;
    }

    /* Images (following Publii's image classes) */

    img {
      max-width: 100% !important;
      height: auto !important;
      /* lock aspect ratio */
      break-inside: avoid;
      display: block;
      margin: 0 auto;
    }

    figure.post__image {
      display: block !important;
      width: 100% !important;
      margin: 0.5rem 0 !important;
      overflow: hidden !important;
      /* Acts as a clearfix so text stays below */
      break-inside: avoid;
      /* Prevents the image/caption from splitting across pages */
    }

    figure.post__image--left {
      padding: 10px;
      float: left !important;
      width: 60% !important;
      margin: 0 !important;
    }

    figure.post__image--left+figcaption {
      float: right !important;
      /* Float to the opposite side */
      clear: none !important;
      /* Do NOT push under the image */
      width: 35% !important;
      /* Leaves a 5% gap in the middle */
      text-align: left !important;
      /* Hugs the text towards the image */
      text-align-last: left !important;
      margin: 0 !important;
    }

    figure.post__image--right {
      padding: 10px;
      float: right !important;
      width: 60% !important;
      margin: 0 !important;
    }

    figure.post__image--right+figcaption {
      float: left !important;
      clear: none !important;
      width: 35% !important;
      text-align: right !important;
      text-align-last: right !important;
      margin: 0 !important;
    }

    figure.post__image--center {
      display: block !important;
      float: none !important;
      margin: 0.5rem auto !important;
    }

    figure.post__image--center+figcaption {
      text-align: center !important;
      text-align-last: center !important;
      width: 100% !important;
    }

    figure.post__image--wide,
    figure.post__image--full {
      display: block !important;
      float: none !important;
      width: 100% !important;
      margin: 0.5rem 0 !important;
    }

    figcaption {
      font-family: var(--font-body);
      font-size: 8pt;
      color: #555;
      margin-top: 0.5rem;
      display: block;
    }

    /* Special Named page that removes margins and content */
    @page emptypage {
      margin: 0;
      /* Top Margin Boxes */
      @top-left-corner { content: none !important; }
      @top-left { content: none !important; }
      @top-center { content: none !important; }
      @top-right { content: none !important; }
      @top-right-corner { content: none !important; }

      /* Bottom Margin Boxes */
      @bottom-left-corner { content: none !important; }
      @bottom-left { content: none !important; }
      @bottom-center { content: none !important; }
      @bottom-right { content: none !important; }
      @bottom-right-corner { content: none !important; }

      /* Side Margin Boxes */
      @left-top { content: none !important; }
      @left-middle { content: none !important; }
      @left-bottom { content: none !important; }
      @right-top { content: none !important; }
      @right-middle { content: none !important; }
      @right-bottom { content: none !important; }
    }

    .full-image-page {
      page: emptypage;
      break-before: page;
      break-after: page;
      box-sizing: border-box;
      
      /* Add a safe white margin (adjust the mm as needed) */
      padding: 5mm; 
    }

    .full-image-page img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      /* Use object-position in the particular style of the element to put it in particular places */
    }

    /* --- Sidenotes --- */
    .sidenote {
      width: 25mm;
      font-family: var(--font-body);
      font-size: 7.5pt;
      line-height: 1.3;
      clear: both;
      text-align: left;
      text-align-last: left;
    }

    /* On Left pages, push the note into the left margin */
    .pagedjs_left_page .sidenote {
      float: left;
      margin-left: -30mm;
    }

    /* On Right pages, push the note into the right margin */
    .pagedjs_right_page .sidenote {
      float: right;
      margin-right: -30mm;
    }

    /* Canvas page */
    .canvas-page {
      page: emptypage;
      break-after: page;
      position: relative;
      display: block; 
      break-inside: avoid;
    }

    /* Ensure all text elements sit on top of the canvas */
    .canvas-page > *:not(.generative-canvas,.generative-separator) {
      position: relative;
      z-index: 10;
    }

    /* The canvas stays pinned to the edges */
    .generative-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    /* Inline Generative Separators */
    .generative-separator {
      display: block;
      width: 100%;
      height: 10mm; /* A fixed physical height for print */
      margin: 2mm 0; /* Breathing room above and below */
    }
  </style>
</head>

<body>
  <main class="page print-container">
    {{#page}}
    <article>
      <div id="page-entry">
        {{{text}}}
      </div>
    </article>
    {{/page}}
  </main>
</body>

<script src="{{js "p5.min.js"}}"></script>
<script src="{{js "zine.js"}}"></script>
<script src="{{js "paged.polyfill.js"}}" onload="startZine()"></script>

</html>